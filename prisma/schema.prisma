generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  password         String
  role             Role              @default(STUDENT)
  nisn             String?           @unique
  nip              String?           @unique
  /// Chat ID angka (DM bot) — terisi otomatis saat ortu pakai tautan unik + webhook; tidak diisi lewat form Excel
  parentTelegram         String?
  /// Token sekali pakai untuk tautan t.me/bot?start=ortu_<token> — ortu tap Start, ID tersimpan otomatis
  parentTelegramLinkToken String? @unique
  classId          String?
  class            Class?            @relation(fields: [classId], references: [id])
  records          ViolationRecord[]
  pointAdjustments PointAdjustment[]
  /// Legacy flag — selalu di-sync dari `status` (ACTIVE ↔ true). Jangan dihapus demi kompatibilitas.
  active           Boolean           @default(true)
  /// Lifecycle status (source of truth untuk login & filter operasional)
  status           UserStatus        @default(ACTIVE)
  graduatedAt      DateTime?
  leftAt           DateTime?
  lastAcademicYear String?
  createdFrom      UserCreatedFrom   @default(MANUAL)
  /// Google OAuth subject (Phase 3). Unique; null = belum linked.
  googleSub        String?           @unique
  authProvider     AuthProvider      @default(CREDENTIALS)
  emailVerifiedAt  DateTime?
  authVersion      Int               @default(0)
  /// Percobaan login gagal beruntun (di-reset saat sukses / admin reset password)
  failedLoginCount Int               @default(0)
  /// Kunci akun sementara setelah terlalu banyak gagal login
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  passwordChangedAt DateTime?
  /// Foto profil (data URL base64 JPEG/PNG)
  photoData        String?           @db.Text
  /// Ringkas untuk UI daftar — ada foto (tanpa load kolom besar)
  photoPresent     Boolean           @default(false)
  /// Jabatan tampilan (mis. "Piket", "Wali Kelas X IPA 1") — bukan permission
  jabatan          String?
  /// Soft-delete — null = aktif di daftar; set saat dihapus lewat UI/API
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  authLoginEvents  AuthLoginEvent[]
  lifecycleEvents  UserLifecycleEvent[]

  @@index([status])
  @@index([role, status])
  @@index([deletedAt])
}

/// Audit perubahan lifecycle / linking (bukan hard delete)
model UserLifecycleEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      String
  fromStatus String?
  toStatus   String?
  reason     String?
  actorId    String?
  actorName  String?
  meta       String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

/// Audit percobaan login (sukses/gagal) — tanpa menyimpan password
model AuthLoginEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Identifier yang dicoba (email / NISN / NIP), dinormalisasi
  identifier String?
  provider   String
  success    Boolean
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

/// Log akses terpusat untuk Super Admin (login + mutasi data). Tanpa FK actor agar bertahan setelah hard-delete.
model AccessLog {
  id         String             @id @default(cuid())
  createdAt  DateTime           @default(now())
  portal     AccessLogPortal
  category   AccessLogCategory
  action     String
  success    Boolean            @default(true)
  actorId    String?
  actorName  String?
  actorRole  String?
  targetType String?
  targetId   String?
  summary    String
  meta       String?            @db.Text
  ip         String?
  userAgent  String?

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([portal, createdAt])
}

enum AccessLogPortal {
  STUDENT
  STAFF
  SYSTEM
}

enum AccessLogCategory {
  LOGIN
  DATA
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  LEFT
  SUSPENDED
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  BOTH
}

enum UserCreatedFrom {
  MANUAL
  ACADEMIC_IMPORT
  GOOGLE_LINK
}

model Class {
  id        String   @id @default(cuid())
  name      String
  grade     String
  major     String
  year      String
  students  User[]
  createdAt DateTime @default(now())
}

model ViolationType {
  id          String    @id @default(cuid())
  name        String
  /// Kode bagian (FK soft ke ViolationBagian.id), mis. KELAKUAN
  section     String?
  category    Category
  points      Int
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  records     ViolationRecord[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([section, sortOrder])
}

/// Master bagian jenis pelanggaran (Kelakuan, Kerajinan, …). Admin bisa menambah.
model ViolationBagian {
  id        String   @id
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, label])
}

enum Category {
  RINGAN
  SEDANG
  BERAT
}

model ViolationRecord {
  id                    String        @id @default(cuid())
  student               User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId             String
  violationType         ViolationType @relation(fields: [violationTypeId], references: [id])
  violationTypeId       String
  session               String?
  notes                 String?
  points                Int
  date                  DateTime      @default(now())
  createdByName         String?
  /// Bukti foto pertama (data URL) — denormalisasi untuk kompatibilitas; sumber utama di evidenceImages
  evidenceImageData     String?       @db.Text
  /// Ringkas untuk UI daftar — ada foto bukti (tanpa load kolom besar)
  evidenceImagePresent  Boolean       @default(false)
  /// Tanda tangan digital murid (data URL gambar atau teks pengakuan)
  studentSignatureData  String?       @db.Text
  /// true jika laporan dikirim dari portal siswa (bukan input staf)
  submittedByStudent    Boolean       @default(false)
  /// Soft-delete — null = tampil di daftar; set saat dihapus lewat UI/API
  deletedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  evidenceImages        ViolationEvidenceImage[]

  @@index([submittedByStudent, createdAt])
  @@index([deletedAt])
}

/// Foto bukti pelanggaran (bisa banyak per catatan).
model ViolationEvidenceImage {
  id        String          @id @default(cuid())
  recordId  String
  record    ViolationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  sortOrder Int             @default(0)
  imageData String          @db.Text
  createdAt DateTime        @default(now())

  @@index([recordId, sortOrder])
}

/// Pengaturan key–value (redaksi lama, threshold SP/skorsing).
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Master redaksi surat cetak. Admin dapat menambah, mengubah, dan menghapus jenis surat.
model PrintTemplate {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  /// HTML dokumen (Tiptap). Legacy plain text di-migrate otomatis.
  body         String   @db.Text
  /// JSON DocumentPageSettings: paper, orientation, margin, header/footer, dll.
  pageSettings String?  @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder, title])
}

/// Koreksi poin (nilai negatif). Digunakan untuk pengurangan 25% setelah periode tenang.
model PointAdjustment {
  id                String   @id @default(cuid())
  studentId         String
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pointsDelta       Int
  reason            String
  grossTotalBefore  Int
  createdAt         DateTime @default(now())

  @@index([studentId])
  @@index([studentId, reason])
}
