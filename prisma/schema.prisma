generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  password         String
  role             Role              @default(STUDENT)
  nisn             String?           @unique
  nip              String?           @unique
  /// Chat ID angka atau @username Telegram orang tua/wali (untuk notifikasi pelanggaran)
  parentTelegram   String?
  classId          String?
  class            Class?            @relation(fields: [classId], references: [id])
  records          ViolationRecord[]
  pointAdjustments PointAdjustment[]
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

enum Role {
  STUDENT
  TEACHER
  PIKET
  WALI_KELAS
  SUPER_ADMIN
}

model Class {
  id        String   @id @default(cuid())
  name      String
  grade     String
  major     String
  year      String
  students  User[]
  createdAt DateTime @default(now())
}

model ViolationType {
  id          String    @id @default(cuid())
  name        String
  category    Category
  points      Int
  description String?
  active      Boolean   @default(true)
  records     ViolationRecord[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Category {
  RINGAN
  SEDANG
  BERAT
}

model ViolationRecord {
  id                    String        @id @default(cuid())
  student               User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId             String
  violationType         ViolationType @relation(fields: [violationTypeId], references: [id])
  violationTypeId       String
  session               String?
  notes                 String?
  points                Int
  date                  DateTime      @default(now())
  createdByName         String?
  /// Bukti foto (data URL base64), wajib untuk poin > ambang bila tidak ada tanda tangan
  evidenceImageData     String?       @db.Text
  /// Tanda tangan digital murid (data URL gambar atau teks pengakuan)
  studentSignatureData  String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

/// Pengaturan key–value (koordinator cetak, redaksi, jadwal review).
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Koreksi poin (nilai negatif). Digunakan untuk pengurangan 25% setelah periode tenang.
model PointAdjustment {
  id                String   @id @default(cuid())
  studentId         String
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  pointsDelta       Int
  reason            String
  grossTotalBefore  Int
  createdAt         DateTime @default(now())

  @@index([studentId])
  @@index([studentId, reason])
}
