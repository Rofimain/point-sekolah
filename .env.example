# ==========================================
# Runtime: di production = secret ENV_FILE_CONTENT
# Format: key=value TANPA tanda kutip (hindari “ ” dari Word/Docs).
# NEXT_PUBLIC_* branding di-bake saat docker build via GitHub Variables.
# Username Telegram: TELEGRAM_BOT_USERNAME (runtime, tanpa @).
# ==========================================

POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=point_sekolah
DATABASE_URL=postgresql://USER:PASSWORD@db:5432/point_sekolah
DIRECT_URL=postgresql://USER:PASSWORD@db:5432/point_sekolah

NEXTAUTH_SECRET=ganti_dengan_openssl_rand_base64_32
NEXTAUTH_URL=https://tanse.smai-alazhar1.com

NEXT_PUBLIC_SCHOOL_NAME=SMA Islam Al-Azhar 1 Jakarta
NEXT_PUBLIC_SCHOOL_SHORT=Al-Azhar 1
NEXT_PUBLIC_SCHOOL_NAME_SHORT=SMA Islam Al Azhar 1
NEXT_PUBLIC_STUDENT_DOMAIN=smaalazhar1.sch.id
NEXT_PUBLIC_STAFF_DOMAIN=smaalazhar1.sch.id

NEXT_PUBLIC_CRITICAL_POINTS=75
NEXT_PUBLIC_WARNING_POINTS=50
NEXT_PUBLIC_HEAVY_VIOLATION_POINTS=20

DEFAULT_STUDENT_PASSWORD=Siswa@123456

AUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# Wajib sama di app + service cron (header x-cron-secret)
CRON_SECRET=isi_random_panjang
POINT_REDUCTION_QUIET_DAYS=30
TZ=Asia/Jakarta

TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=openssl_rand_hex_32
TELEGRAM_BOT_USERNAME=alpuspoint_bot
